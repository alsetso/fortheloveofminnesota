# For the Love of Minnesota — local env (one file, all apps)
#
# 1. cp env.local.example env.local
# 2. Paste secrets into the SHARED block (same Supabase / Mapbox / R2 on every app)
# 3. ./scripts/install-local-env.sh
#    That writes apps/*/.env.local with the right localhost ports.
#
# Or paste a single BEGIN/END block below into that app’s .env.local by hand.
# Never commit env.local or apps/*/.env.local.

# =============================================================================
# SHARED — fill once
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://hfklpjuiuhbulztsqapv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Admin reads this alias (same Mapbox public token):
NEXT_PUBLIC_MAPBOX_TOKEN=

OPENAI_API_KEY=
RAPIDAPI_KEY=

R2_ACCOUNT_ID=25a5c814e48fcffe851e3688371e4b8f
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=community-media
NEXT_PUBLIC_R2_PUBLIC_URL=

# Optional — web v1 Stripe / cron
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_CONTRIBUTOR_PRICE_ID=
# STRIPE_BUSINESS_PRICE_ID=
# STRIPE_GOVERNMENT_PRICE_ID=
# STRIPE_CREDITS_PRICE_ID=
# CRON_SECRET=
# NEXT_PUBLIC_USE_MOCK_DATA=false
# NEXT_PUBLIC_ENABLE_TILE_PRELOAD=false

# Optional — iOS / web v2 IAP + App Store Connect
# NEXT_PUBLIC_REVENUECAT_DEFAULT_OFFERING=ios
# REVENUECAT_WEBHOOK_SECRET=
# STRIPE_CONTRIBUTOR_MONTHLY_PRICE_ID=
# STRIPE_TOOL_CREDITS_PACK_25_PRICE_ID=
# STRIPE_TOOL_CREDITS_PACK_100_PRICE_ID=
# STRIPE_TOOL_CREDITS_PACK_250_PRICE_ID=
# ALLOW_DEV_CREDIT_PURCHASE=1
# ASC_APP_ID=
# ASC_BUNDLE_ID=
# ASC_ISSUER_ID=
# ASC_KEY_ID=
# ASC_PRIVATE_KEY_PATH=

# Email OTP: RESEND_API_KEY is a Supabase Edge Function secret, not an app env.
#   supabase secrets set RESEND_API_KEY=re_...

# =============================================================================
# READY-TO-PASTE APP BLOCKS
# After filling SHARED, you can skip these and run ./scripts/install-local-env.sh
# Ports: web 3000 · web_v2 3001 · ios 3002 · admin 3003 · free-ios 3004
# =============================================================================

# ===== BEGIN apps/web =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_TILE_PRELOAD=false
# ===== END apps/web =====

# ===== BEGIN apps/web_v2 =====
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# ===== END apps/web_v2 =====

# ===== BEGIN apps/ios =====
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# ===== END apps/ios =====

# ===== BEGIN apps/admin =====
NEXT_PUBLIC_APP_URL=http://localhost:3003
# ===== END apps/admin =====

# ===== BEGIN apps/free-ios =====
NEXT_PUBLIC_APP_URL=http://localhost:3004
# ===== END apps/free-ios =====
