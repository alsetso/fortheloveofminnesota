# Copy to .env.local — never commit real secrets.
# Easiest: copy these two from apps/ios/.env.local (same hosted project).

# ── Required for email OTP (browser) ─────────────────────────────────────────
# Must be the hosted project URL/anon — NOT 127.0.0.1 unless `supabase start` is running.
NEXT_PUBLIC_SUPABASE_URL=https://hfklpjuiuhbulztsqapv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Map / app ────────────────────────────────────────────────────────────────
# Public token with Styles + Geocoding + Search Box API enabled (account.mapbox.com → token scopes).
# Used for the map, reverse geocode, and nearby places (GET /api/geo/nearby).
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
# Optional style override
# NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/standard

NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ── Optional (server routes — wallet, tools, AI, RapidAPI, payments) ─────────
# Place AI (Responses API + web_search). Without this, localhost uses seat/profile fallback.
# OPENAI_API_KEY=sk-...
# Answer modes map to models (defaults: gpt-5-mini for all if unset).
# OPENAI_SUBJECT_MODEL=gpt-5-mini
# OPENAI_SUBJECT_MODEL_FAST=gpt-5-mini
# OPENAI_SUBJECT_MODEL_DEEP=gpt-5
# Required for GET /api/wallet/summary and tool credit charges.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Required for public-records + real-estate lookups (same key as apps/ios).
# RAPIDAPI_KEY=your_rapidapi_key_here
#
# Stripe (web / localhost checkout for credit packs)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_CONTRIBUTOR_MONTHLY_PRICE_ID=price_... # $24.99/mo — match ASC contributor_monthly
# STRIPE_TOOL_CREDITS_PACK_25_PRICE_ID=price_...  # $9.99
# STRIPE_TOOL_CREDITS_PACK_100_PRICE_ID=price_... # $49.99
# STRIPE_TOOL_CREDITS_PACK_250_PRICE_ID=price_... # $99.99
# ALLOW_DEV_CREDIT_PURCHASE=1
#
# RevenueCat (Despia IAP) — also paste public keys in Despia Editor
# NEXT_PUBLIC_REVENUECAT_DEFAULT_OFFERING=ios
# Must exactly match the "Authorization header" value configured on the RC
# webhook integration (RevenueCat → Project → Integrations → Webhooks → ios),
# which points at /api/revenuecat/webhook. Grants Contributor + credits packs.
# REVENUECAT_WEBHOOK_SECRET=...

# ── Cloudflare R2 (community post media — server-side presign) ───────────────
# Dashboard first (R2 must be enabled on the account):
#   1. Create bucket `community-media`
#   2. API Tokens → Object Read & Write scoped to that bucket
#   3. Custom domain (preferred) or r2.dev for smoke tests
#   4. CORS: paste apps/ios/r2-cors.json (add Despia/TestFlight + production hosts)
#   5. Optional P1: R2 lifecycle rule for capture-then-discard orphan objects
R2_ACCOUNT_ID=25a5c814e48fcffe851e3688371e4b8f
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=community-media
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.yourdomain.com

# ── Email OTP delivery (NOT an ios-2 env var) ────────────────────────────────
# Auth uses Supabase Auth → Auth Hook `send_email` → Edge Function `resend`.
# RESEND_API_KEY lives in Supabase secrets, same as ios:
#   Local:  supabase secrets set RESEND_API_KEY=re_...
#   Prod:   Dashboard → Project → Edge Functions → Secrets
# Hook URI (prod): https://hfklpjuiuhbulztsqapv.supabase.co/functions/v1/resend
